{
  "version": "2.0.4",
  "license": "MIT",
  "name": "jbrowse-plugin-tview",
  "keywords": [
    "jbrowse",
    "jbrowse2"
  ],
  "main": "dist/index.js",
  "files": [
    "dist",
    "src"
  ],
  "config": {
    "port": 9000,
    "browse": {
      "port": 8999
    },
    "jbrowse": {
      "plugin": {
        "name": "TView"
      }
    }
  },
  "scripts": {
    "clean": "rimraf dist",
    "start": "node esbuild.mjs",
    "format": "pnpm prettier --write .",
    "build": "tsc && NODE_ENV=production node esbuild.mjs",
    "prebuild": "pnpm clean",
    "lint": "eslint src --report-unused-disable-directives --max-warnings 0",
    "prepack": "pnpm build",
    "postversion": "git push --follow-tags",
    "preversion": "pnpm lint"
  },
  "jbrowse-plugin": {
    "name": "TView"
  },
  "dependencies": {
    "react-msaview": "^4.0.0"
  },
  "devDependencies": {
    "@emotion/react": "^11.10.4",
    "@fal-works/esbuild-plugin-global-externals": "^2.1.2",
    "@jbrowse/core": "^3.4.0",
    "@jbrowse/plugin-linear-genome-view": "^3.4.0",
    "@mui/icons-material": "^7.1.0",
    "@mui/material": "^7.1.0",
    "@mui/system": "^7.1.0",
    "@mui/x-data-grid": "^8.4.0",
    "@types/node": "^22.15.21",
    "@types/react": "^19.1.5",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "cors": "^2.8.5",
    "esbuild": "^0.25.4",
    "eslint": "^10.2.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unicorn": "^64.0.0",
    "express": "^5.1.0",
    "mobx": "^6.10.2",
    "mobx-react": "^9.0.1",
    "mobx-state-tree": "^5.3.0",
    "prettier": "^3.3.3",
    "pretty-bytes": "^7.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "request": "^2.88.2",
    "rimraf": "^6.0.0",
    "rxjs": "^7.8.1",
    "serve-static": "^2.2.0",
    "tss-react": "^4.9.2",
    "typescript": "^5.2.2",
    "typescript-eslint": "^8.59.1",
    "@eslint/js": "^10.0.1",
    "eslint-plugin-import-x": "^4.16.2"
  }
}
