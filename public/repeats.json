{
  "plugins": [
    {
      "name": "TView",
      "url": "http://localhost:9000/dist/out.js"
    }
  ],
  "assemblies": [
    {
      "name": "hg19",
      "displayName": "Human (hg19)",
      "sequence": {
        "type": "ReferenceSequenceTrack",
        "trackId": "hg19-refseq",
        "adapter": {
          "type": "TwoBitAdapter",
          "uri": "https://hgdownload.soe.ucsc.edu/goldenPath/hg19/bigZips/hg19.2bit",
          "chromSizes": "https://jbrowse.org/ucsc/hg19/hg19.chrom.sizes"
        }
      },
      "refNameAliases": {
        "adapter": {
          "type": "RefNameAliasAdapter",
          "uri": "https://jbrowse.org/ucsc/hg19/hg19.chromAlias.txt"
        }
      },
      "cytobands": {
        "adapter": {
          "type": "CytobandAdapter",
          "uri": "https://jbrowse.org/ucsc/hg19/hg19.cytoBand.txt.gz"
        }
      }
    }
  ],
  "tracks": [
    {
      "type": "AlignmentsTrack",
      "trackId": "HG002",
      "name": "HG002 (son)",
      "category": ["GIAB Ashkenazi trio", "PacBio HiFi"],
      "assemblyNames": ["hg19"],
      "adapter": {
        "type": "BamAdapter",
        "uri": "https://ftp-trace.ncbi.nlm.nih.gov/giab/ftp/data/AshkenazimTrio/HG002_NA24385_son/PacBio_CCS_15kb_20kb_chemistry2/GRCh37/HG002.SequelII.merged_15kb_20kb.pbmm2.hs37d5.haplotag.RTG.10x.trio.bam"
      }
    },
    {
      "type": "AlignmentsTrack",
      "trackId": "HG003",
      "name": "HG003 (father)",
      "category": ["GIAB Ashkenazi trio", "PacBio HiFi"],
      "assemblyNames": ["hg19"],
      "adapter": {
        "type": "BamAdapter",
        "uri": "https://ftp-trace.ncbi.nlm.nih.gov/giab/ftp/data/AshkenazimTrio/HG003_NA24149_father/PacBio_CCS_15kb_20kb_chemistry2/hs37d5/HG003.SequelII.merged_15kb_20kb.pbmm2.hs37d5.haplotag.RTG.10x.trio.bam"
      }
    },
    {
      "type": "AlignmentsTrack",
      "trackId": "HG004",
      "name": "HG004 (mother)",
      "category": ["GIAB Ashkenazi trio", "PacBio HiFi"],
      "assemblyNames": ["hg19"],
      "adapter": {
        "type": "BamAdapter",
        "uri": "https://ftp-trace.ncbi.nlm.nih.gov/giab/ftp/data/AshkenazimTrio/HG004_NA24143_mother/PacBio_CCS_15kb_20kb_chemistry2/hs37d5/HG004.SequelII.merged_15kb_20kb.pbmm2.hs37d5.haplotag.RTG.10x.trio.bam"
      }
    }
  ],
  "defaultSession": {
    "name": "FMR1 CGG repeat in the GIAB trio",
    "views": [
      {
        "id": "repeats_lgv",
        "type": "LinearGenomeView",
        "init": {
          "loc": "chrX:146,993,530..146,993,670",
          "assembly": "hg19",
          "tracks": ["HG002", "HG003", "HG004"]
        }
      },
      {
        "id": "repeats_tview",
        "type": "TView",
        "displayName": "FMR1 (CGG)n",
        "connectedViewId": "repeats_lgv",
        "colWidth": 6,
        "rowHeight": 6,
        "labelsAlignRight": true,
        "colorSchemeName": "jbrowse_dna",
        "drawTree": true,
        "treeAreaWidth": 330,
        "init": {
          "assembly": "hg19",
          "loc": "chrX:146,993,530..146,993,670",
          "tracks": [
            { "trackId": "HG002", "sample": "HG002_son" },
            { "trackId": "HG003", "sample": "HG003_father" },
            { "trackId": "HG004", "sample": "HG004_mother" }
          ]
        }
      }
    ]
  }
}
